{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Jotter",
  "version": "0.1.3",
  "identifier": "com.iskrendesign.jotter",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Jotter",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
    "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0NzI0M0FENUIwM0M0NjYKUldSbXhBTmJyVU55OURBend4MG5jNXFxck14UG5jQmtjS1VZdzdEckJSNDYxTHIzMnhjK1diZG0K",
      "endpoints": [
        "https://github.com/iskrenDesign/jotter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

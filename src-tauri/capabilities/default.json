{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
    "permissions": [
    "core:default",
    "fs:default",
    "fs:write-all",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DOCUMENT/Jotter" },
        { "path": "$DOCUMENT/Jotter/**" }
      ]
    }
  ]
}